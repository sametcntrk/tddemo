# /etc/core-demo.env — tanımlamadığın servisin kartı "yapılandırılmadı" görünür.
# DİKKAT: systemd satır sonu yorumlarını desteklemez; yorumlar ayrı satırda olmalı.
# Değiştirdikten sonra: sudo systemctl restart core-demo

# Boşsa instance metadata'dan alınır
# AWS_REGION=eu-central-1

# ---------- RDS ----------
# mysql | postgres  (MariaDB / Aurora MySQL için mysql, Aurora PostgreSQL için postgres)
DB_ENGINE=mysql
DB_HOST=mydb.xxxxxxxx.eu-central-1.rds.amazonaws.com
# Varsayılan: mysql 3306, postgres 5432
# DB_PORT=3306
# mysql: yoksa oluşturulur (varsayılan demo) | postgres: varsayılan postgres
# DB_NAME=demo
DB_USER=admin
DB_PASSWORD=degistir
# Şifreyi dosyada tutmak yerine RDS'in Secrets Manager'daki master secret'ı (DB_PASSWORD'ü ezer):
# DB_SECRET_ARN=arn:aws:secretsmanager:eu-central-1:111122223333:secret:rds!db-xxxx

# ---------- Opsiyonel servisler ----------
# S3_BUCKET=core-demo-bucket-123
# S3_PREFIX=demo/
# DynamoDB tablosu, partition key: pk (String)
# DDB_TABLE=core-demo
# DDB_PK=pk
# SQS_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/111122223333/core-demo
# SNS_TOPIC_ARN=arn:aws:sns:eu-central-1:111122223333:core-demo
# ElastiCache: serverless veya in-transit encryption açıksa REDIS_TLS=true
# REDIS_HOST=core-demo.xxxxxx.cache.amazonaws.com
# REDIS_TLS=false
# EFS_PATH=/mnt/efs
# DEMO_SECRET_ID=core-demo/secret
# SSM_PARAM_NAME=/core-demo/message
